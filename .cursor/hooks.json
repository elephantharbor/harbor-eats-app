{
  "version": 1,
  "hooks": {
    "subagentStart": [
      { "command": "python3 .cursor/hooks/eh/model_gate.py subagentStart", "failClosed": true, "timeout": 10 }
    ],
    "preToolUse": [
      { "command": "python3 .cursor/hooks/eh/model_gate.py preToolUse", "failClosed": false, "timeout": 10 }
    ],
    "beforeSubmitPrompt": [
      { "command": "python3 .cursor/hooks/eh/model_gate.py beforeSubmitPrompt", "failClosed": false, "timeout": 10 }
    ],
    "subagentStop": [
      { "command": "python3 .cursor/hooks/eh/model_gate.py subagentStop", "loop_limit": 0 }
    ],
    "stop": [
      { "command": "python3 .cursor/hooks/eh/model_gate.py stop", "loop_limit": 0 }
    ]
  }
}
