        "clock_minutes": 12,
        "clock_phase": "prep"
      },
      {
        "step_number": 2,
        "title": "Render the bacon",
        "body": "Cook the bacon in the pot over medium until crisp, 7 minutes. Lift out half for garnish, leaving the rest and the drippings.",
        "ingredient_refs": [
          "bacon"
        ],
        "clock_minutes": 7,
        "clock_phase": "cook"
      },
      {
        "step_number": 3,
        "title": "Soften the vegetables",
        "body": "Add the butter, onion, and celery and cook until soft, 6 minutes. Stir in the flour and cook 2 minutes.",
        "ingredient_refs": [
          "butter",
          "yellow-onion",
          "celery",
          "flour"
        ],
        "clock_minutes": 8,
        "clock_phase": "cook"
      },
      {
        "step_number": 4,
        "title": "Simmer the potatoes",
        "body": "Gradually stir in the bottled clam juice and the reserved juice from the cans, then add the potatoes, thyme, and bay leaf. Simmer on medium-low, stirring often, until the potatoes are tender, 15 minutes.",
        "ingredient_refs": [
          "clam-juice",
          "chopped-clams",
          "potatoes",
          "thyme",
          "bay-leaf"
        ],
        "clock_minutes": 15,
        "clock_phase": "cook"
      },
      {
        "step_number": 5,
        "title": "Add dairy and clams",
        "body": "Lower the heat, stir in the milk, cream, and clams, and heat until steaming, 5 minutes; do not boil. Discard the thyme stems and bay, then season with pepper and salt to taste.",
        "ingredient_refs": [
          "milk",
          "heavy-cream",
          "chopped-clams",
          "black-pepper",
          "kosher-salt"
        ],
        "clock_minutes": 5,
        "clock_phase": "cook"
      },
      {
        "step_number": 6,
        "title": "Serve",
        "body": "Ladle into bowls and top with the reserved bacon and chives. Serve with oyster crackers.",
        "ingredient_refs": [
          "bacon",
          "chives",
          "oyster-crackers"
        ],
        "clock_minutes": 2,
        "clock_phase": "cook"
