          "garlic powder",
          "kosher salt",
          "black pepper"
        ]
      },
      {
        "step_number": 3,
        "title": "Crisp the tofu",
        "body": "Air fry at 400°F for 14–18 minutes, shaking halfway, until deep golden. Skillet option: medium-high heat 8–10 minutes, turning. Finish with the juice of 1/2 lime.",
        "ingredient_refs": [
          "extra-firm tofu",
          "lime"
        ]
      },
      {
        "step_number": 4,
        "title": "Make the lime slaw",
        "body": "Toss the cabbage, carrot, and cilantro with the juice of 1 lime, the remaining 2 tsp neutral oil, 1/4 tsp kosher salt, and 1/4 tsp black pepper. Rest 5 minutes. Do this during the end of the air fry so it stays inside the cook time.",
        "ingredient_refs": [
          "green cabbage",
          "carrot",
          "cilantro",
          "lime",
          "neutral oil",
          "kosher salt",
          "black pepper"
        ]
      },
      {
        "step_number": 5,
        "title": "Warm tortillas and build",
        "body": "Warm the tortillas in a dry skillet 20–30 seconds per side. Build each taco with tofu, slaw, and avocado. Serve with the remaining 1/2 lime cut into wedges.",
        "ingredient_refs": [
          "corn tortillas",
